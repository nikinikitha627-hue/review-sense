# ==============================================================
# Antigravity Starter — Environment Variables
# Copy to .env and fill in values
# ==============================================================

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8192

# --- Backend ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Dev: SQLite
DATABASE_URL=sqlite:///./antigravity.db
# Prod: Postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/antigravity

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Antigravity

# --- Antigravity Pipeline ---
PIPELINE_OUTPUT_DIR=antigravity/outputs
PIPELINE_LOG_LEVEL=debug

# --- Optional: OpenRouter (for multi-model routing) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
